{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": false,
    "outDir": ".seed-dist",
    "rootDir": "src",
    "sourceMap": false
  },
  "include": [
    "src/database/seed.ts",
    "src/rbac/permissions.ts",
    "src/rbac/system-role-templates.ts",
    "src/generated/prisma/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
