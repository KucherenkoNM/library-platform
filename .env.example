# Development-only example values. Never use these credentials in production.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1

POSTGRES_DB=chitay
POSTGRES_USER=chitay
POSTGRES_PASSWORD=chitay_dev_password
DATABASE_URL=postgresql://chitay:chitay_dev_password@localhost:5432/chitay?schema=public

REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=chitay
MINIO_ROOT_PASSWORD=chitay_dev_minio_password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=chitay
S3_SECRET_KEY=chitay_dev_minio_password
S3_BUCKET=chitay-dev
S3_FORCE_PATH_STYLE=true

# Authentication (development-only values; rotate for every deployed environment)
AUTH_ACCESS_TOKEN_SECRET=dev-only-stage2-access-token-secret-change-me-now
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=chitay_refresh
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_ISSUER=chitay-api
AUTH_TOKEN_AUDIENCE=chitay-web
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
